@page
@model RazorPagesMovie.Pages.Movies.IndexModel

@{
    ViewData["Title"] = "Index";
}
<section class="hero-section relative text-white overflow-hidden">
    <!-- Background Image -->
    <div class="hero-bg absolute inset-0">
        <img src="https://source.unsplash.com/1600x900/?cinema,movies"
             alt="Hero Background"
             class="w-full h-full object-cover">
        <!-- Animated Gradient Overlay -->
        <div class="hero-gradient absolute inset-0"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative max-w-7xl mx-auto px-6 py-32 text-center">
        <h1 class="hero-title text-4xl sm:text-5xl font-extrabold mb-4 opacity-0">Welcome to MovieHub</h1>
        <p class="hero-subtitle text-lg sm:text-xl mb-8 opacity-0">Discover your next favorite movie or series today!</p>
        <a asp-page="/Movies/Index"
           class="hero-button inline-block bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-3 rounded-lg transition opacity-0">
            🎬 Browse Movies
        </a>
    </div>
</section>


<div class="text-center mt-5">
    <p class="lead">Your best movies are here</p>

    <a class="btn btn-primary btn-lg mt-4" asp-page="/Movies/Index">
        🎬 Movies
    </a>
</div>


<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<form>
    <p>
        <select asp-for="MovieGenre" asp-items="Model.Genres">
            <option value="">All</option>
        </select>
        <label>Title: <input type="text" asp-for="SearchString" /></label>
        <input type="submit" value="Filter" />
    </p>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Movie[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movie[0].ReleaseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movie[0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movie[0].Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movie[0].Rating)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Movie) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReleaseDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Genre)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Rating)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
